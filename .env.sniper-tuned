# Dry-run profile from SNIPER_IMPROVEMENTS.md §3 — copy overrides into .env to test.
# Do not use as live defaults without validation.

DRY_RUN=true
POSITION_SIZE_USD=1
SNIPER_SLEEP_SECONDS=30

PRICE_THRESHOLD=0.82
MIN_24H_VOLUME=2500
MIN_ORDER_BOOK_DEPTH=1000
MIN_BID_ASK_SPREAD=0.015
PROFIT_TARGET_PCT=3.5
STOP_LOSS_PCT=2.0
MAX_HOURS_TO_RESOLUTION=6
MIN_HOURS_TO_RESOLUTION=0.5
MIN_MARKET_SCORE=3
STOP_LOSS_GRACE_SECONDS=60

# Quick wins enabled for tuned dry-run
TRAILING_STOP=true
TRAILING_STOP_PCT=1.5
TRAILING_STOP_TRIGGER=0.01
SL_BLACKLIST_TTL_HOURS=4
CHECK_RESOLUTION_ON_HOLD=true
SNIPER_BOOK_FETCH_WORKERS=8
PARTIAL_EXIT=true
PARTIAL_EXIT_RATIO=0.5

# Scoring
UPSIDE_POINTS_RESOLUTION=3
UPSIDE_RESOLUTION_WEIGHT=1.5
UPSIDE_POINTS_VOLUME_ACCEL=2
BID_STABILITY_THRESHOLD=0.03
UPSIDE_CATALYST_KEYWORDS=fed,fomc,election,earnings,court,cpi,nfp,payroll,inflation,rate,btc,eth,crypto,gdp,unemployment,sports,nba,nfl,mlb
