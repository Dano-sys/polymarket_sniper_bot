# =============================================================================
# Polymarket sniper — environment reference
# Copy to .env in this folder for overrides (loaded after copy_bot .env).
# Secrets: keep PRIVATE_KEY / POLY_BUILDER_* in polymarket_copy_bot_v2/.env only.
# =============================================================================

# -----------------------------------------------------------------------------
# Run mode and loop
# -----------------------------------------------------------------------------

COPY_BOT_DIR=../polymarket_copy_bot_v2
COPY_BOT_ENV_PATH=
DRY_RUN=true
DRY_RUN_RESET_ON_START=false
PAPER_STARTING_BALANCE_USD=1000
POLYMARKET_ENV_FILE=
SNIPER_SLEEP_SECONDS=60

# -----------------------------------------------------------------------------
# API endpoints and testnet
# -----------------------------------------------------------------------------

CLOB_API=https://clob.polymarket.com
GAMMA_API=https://gamma-api.polymarket.com
TESTNET_CLOB_API=https://amoy-testnet.polymarket.com
TESTNET_MODE=false

# -----------------------------------------------------------------------------
# Live trading (secrets live in copy_bot .env — do not paste keys here in git)
# -----------------------------------------------------------------------------

# FUNDER_ADDRESS=0x...
# POLY_BUILDER_CODE=0x...  # bytes32 builder code from polymarket.com/settings?tab=builder (CLOB V2 orders)
# POLY_BUILDER_API_KEY=
# POLY_BUILDER_PASSPHRASE=
# POLY_BUILDER_SECRET=
# PRIVATE_KEY=0x...
# PROXY_FUNDER_ADDRESS=
# PROXY_PRIVATE_KEY=
# PROXY_SIGNATURE_TYPE=1
# SIGNATURE_TYPE=1
# (see polymarket_copy_bot_v2 for POLY_BUILDER_* and wallet keys)

# -----------------------------------------------------------------------------
# Entry and exit
# -----------------------------------------------------------------------------

# Hours until market end: keep legs with min <= hrs < max (max=0 = no upper cap).
MIN_HOURS_TO_RESOLUTION=0
MAX_HOURS_TO_RESOLUTION=12
# Legacy alias when MAX_HOURS_TO_RESOLUTION is unset:
# HOURS_TO_RESOLUTION=12
MAX_POSITIONS=5
POSITION_SIZE_USD=100
# true = $POSITION_SIZE_USD base; add surplus cash above starting balance (paper) or
# reserved base slots (live), split across remaining open slots.
COMPOUND_POSITIONS=true
# Optional per-trade stake bounds when COMPOUND_POSITIONS=true (0 = no max cap).
# MIN_POSITION_SIZE_USD=1
# MAX_POSITION_SIZE_USD=0
PRICE_THRESHOLD=0.80
PROFIT_TARGET_PCT=2.5
STOP_LOSS_PCT=3.0
# Seconds after entry before stop-loss can fire (bid must drop vs entry bid, not fill).
STOP_LOSS_GRACE_SECONDS=120
# Max (estimated fill − bid) / bid in % at scan (uses ENTRY_DRAG_SLIPPAGE, not full fill slip).
MAX_ENTRY_DRAG_PCT=5.0
ENTRY_DRAG_SLIPPAGE=0.015
REQUIRE_PROFIT_ROOM=false
MAX_OUTCOME_PRICE=1.0
MAX_ENTRY_ASK=
PROFIT_ROOM_PRICE_BUFFER=0.06

# -----------------------------------------------------------------------------
# Liquidity and execution quality
# -----------------------------------------------------------------------------

SNIPER_MARKET_SOURCE=both
SNIPER_MARKET_POOL_SIZE=150
GAMMA_MARKET_PAGE_LIMIT=100
MIN_GAMMA_LIQUIDITY=5000
MIN_24H_VOLUME=5000
MIN_ORDER_BOOK_DEPTH=1000
MIN_BID_ASK_SPREAD=0.015
ORDER_BOOK_TOP_LEVELS=5
SELL_ALLOWANCE_DELAY_SEC=8
SLIPPAGE_TOLERANCE=0.04
SLIPPAGE_TOLERANCE_SELL=0.04

# -----------------------------------------------------------------------------
# Kill switch (loss / errors / halt file)
# -----------------------------------------------------------------------------

SNIPER_KILL_SWITCH=true
# Total PnL (realized + unrealized) must stay above -SNIPER_KILL_MAX_LOSS_USD; 0 = off.
SNIPER_KILL_MAX_LOSS_USD=0
# Session PnL since bot start must stay above -SNIPER_KILL_MAX_SESSION_LOSS_USD; 0 = off.
SNIPER_KILL_MAX_SESSION_LOSS_USD=0
# Consecutive scan-cycle exceptions before kill; 0 = off.
SNIPER_KILL_MAX_CONSECUTIVE_ERRORS=0
# soft = pause new entries, keep managing exits; hard = save state and exit.
SNIPER_KILL_LOSS_ACTION=soft
SNIPER_KILL_ERROR_ACTION=soft
SNIPER_KILL_SOFT_SLEEP_SECONDS=300
# Clear latched hard kill / soft pause on startup.
SNIPER_KILL_CLEAR_ON_START=false
SNIPER_KILL_STATE_FILE=sniper_kill_state.json
# Optional touch file to pause (soft) or stop (hard) without editing .env.
SNIPER_HALT_FILE=
SNIPER_HALT_FILE_MODE=soft

# -----------------------------------------------------------------------------
# State and files
# -----------------------------------------------------------------------------

SNIPER_POSITIONS_FILE=sniper_positions.json
SNIPER_OPEN_ORDERS_FILE=sniper_open_orders.json
SNIPER_PAPER_ACCOUNT_FILE=sniper_paper_account.json
SNIPER_TRADE_LOG_FILE=trade_log.json

# -----------------------------------------------------------------------------
# Network
# -----------------------------------------------------------------------------

HTTP_REQUEST_TIMEOUT_SEC=25
POLYMARKET_PROXY=

# -----------------------------------------------------------------------------
# Upside scoring (CURSOR_CHANGES / max-profit layer)
# -----------------------------------------------------------------------------

MIN_MARKET_SCORE=0
REQUIRE_MARKET_MOMENTUM=false
# Comma-separated substrings matched on question / description (case-insensitive).
UPSIDE_CATALYST_KEYWORDS=fed,fomc,election,earnings,vote,court,ruling,announcement,decision,approval
UPSIDE_MOMENTUM_MAX_SPREAD_PCT=1.5
UPSIDE_MOMENTUM_MIN_ASK=1.0
UPSIDE_POINTS_CATALYST=3
UPSIDE_POINTS_MOMENTUM=2
UPSIDE_POINTS_VOLUME=2
UPSIDE_PRINT_MIN_SCORE=0
UPSIDE_SCORE_MAX=10
UPSIDE_VOLUME_SPIKE_MULTIPLIER=2.0

# -----------------------------------------------------------------------------
# SNIPER_IMPROVEMENTS feature flags (default off — backward compatible)
# See SNIPER_IMPROVEMENTS.md
# -----------------------------------------------------------------------------

# Trailing stop (replaces fixed SL when true)
TRAILING_STOP=false
TRAILING_STOP_PCT=1.5
TRAILING_STOP_TRIGGER=0.01

# Partial profit at target; remainder uses raised stop_loss_floor
PARTIAL_EXIT=false
PARTIAL_EXIT_RATIO=0.5
PARTIAL_EXIT_RESIDUAL_SL=0.0

# Skip markets for TTL hours after stop-loss
SL_BLACKLIST_TTL_HOURS=4
SL_BLACKLIST_FILE=sniper_blacklist.json

# Fast exit when Gamma reports market closed
CHECK_RESOLUTION_ON_HOLD=false
RESOLUTION_EXIT_PRICE=0.99

# Parallel CLOB book fetches during scan
SNIPER_BOOK_FETCH_WORKERS=8

# Raise entry bar as resolution approaches
DYNAMIC_PRICE_THRESHOLD=false
DYNAMIC_THRESHOLD_MAX_BOOST=0.10

# Minimum absolute profit per share (0 = pct only)
MIN_PROFIT_CENTS=0

# Re-entry after close
ALLOW_REENTRY=true
REENTRY_COOLDOWN_MINUTES=15
REENTRY_STATE_FILE=sniper_reentry.json

# Stake multiplier from spread / volume / time
DYNAMIC_POSITION_SIZING=false
MAX_POSITION_QUALITY_MULT=1.75
SIZE_BOOST_TIGHT_SPREAD=0.3
SIZE_BOOST_HIGH_VOLUME=0.2
SIZE_BOOST_NEAR_RESOLUTION=0.25

# Scoring extras (0 = disabled for resolution / accel / blue-chip points)
UPSIDE_POINTS_RESOLUTION=0
UPSIDE_RESOLUTION_WEIGHT=1.5
UPSIDE_VOLUME_ACCEL_THRESHOLD=1.3
UPSIDE_POINTS_VOLUME_ACCEL=0
BID_STABILITY_THRESHOLD=0
BLUE_CHIP_VOLUME_THRESHOLD=0
BLUE_CHIP_PRICE_THRESHOLD=0.77
UPSIDE_POINTS_BLUE_CHIP=0
UPSIDE_SCORE_MODE=legacy

# Gamma cache + volume acceleration history
GAMMA_MARKET_CACHE_TTL_SEC=300
GAMMA_VOL_HISTORY_FILE=gamma_vol_history.json

# Shorter sleep when any open position is <2h to resolution (0 = use SNIPER_SLEEP_SECONDS)
SNIPER_SLEEP_SECONDS_ACTIVE=0

# Fee drag on reported PnL
TAKER_FEE_PCT=0
MAKER_FEE_PCT=0
