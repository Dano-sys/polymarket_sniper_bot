# =============================================================================
# Max-profit preset — non-secret overrides only (merge after .env.example).
# Same section layout as .env.example; empty blocks marked (no overrides).
# =============================================================================

# -----------------------------------------------------------------------------
# Run mode and loop
# -----------------------------------------------------------------------------

# (no overrides in this section)

# -----------------------------------------------------------------------------
# API endpoints and testnet
# -----------------------------------------------------------------------------

# (no overrides in this section)

# -----------------------------------------------------------------------------
# Live trading (secrets live in copy_bot .env — do not paste keys here in git)
# -----------------------------------------------------------------------------

# (no overrides in this section)

# -----------------------------------------------------------------------------
# Entry and exit
# -----------------------------------------------------------------------------

# True sniper window: markets resolving within 24h, skip settlement (<15 min)
MIN_HOURS_TO_RESOLUTION=0.25
MAX_HOURS_TO_RESOLUTION=24

PRICE_THRESHOLD=0.78

# 3% TP is achievable up to ask=0.941; 4.5% required ask≤0.928 but killed too many candidates
PROFIT_TARGET_PCT=3.0
STOP_LOSS_PCT=2.5
STOP_LOSS_GRACE_SECONDS=90

# Enforce that the TP target is physically reachable (entry * 1.03 ≤ 0.97)
# Without this, entries above 0.97/1.03=0.942 can never hit the profit target
REQUIRE_PROFIT_ROOM=true
PROFIT_ROOM_PRICE_BUFFER=0.03
MAX_OUTCOME_PRICE=1.0

# -----------------------------------------------------------------------------
# Liquidity and execution quality
# -----------------------------------------------------------------------------

# 2.5% spread: admits normal-volume 24h-out markets; 1.5% was calibrated for final-hour only
MIN_BID_ASK_SPREAD=0.025
MIN_24H_VOLUME=3000
MIN_ORDER_BOOK_DEPTH=750

# -----------------------------------------------------------------------------
# State and files
# -----------------------------------------------------------------------------

# (no overrides in this section)

# -----------------------------------------------------------------------------
# Network
# -----------------------------------------------------------------------------

# (no overrides in this section)

# -----------------------------------------------------------------------------
# Upside scoring (CURSOR_CHANGES / max-profit layer)
# -----------------------------------------------------------------------------

# Score 2 = momentum-only (auto-fires for any liquid candidate passing other filters)
# Use scoring as a ranker, not a gate — let liquidity filters do the gatekeeping
MIN_MARKET_SCORE=2
REQUIRE_MARKET_MOMENTUM=false

# Lower multiplier so volume spike fires at $4,500 (3000*1.5) not $10,000
UPSIDE_VOLUME_SPIKE_MULTIPLIER=1.5

UPSIDE_CATALYST_KEYWORDS=fed,fomc,election,vote,court,ruling,earnings,cpi,nfp,payroll,gdp,inflation,rate,btc,eth,crypto,nba,nfl,mlb,nhl,world cup,approval,announcement,decision,impeach,tariff,treaty,summit,primary,senate,house,ipo,merger,acquisition
